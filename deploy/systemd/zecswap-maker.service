[Unit]
Description=ZecSwap testnet maker and watchtower
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=zecswap-maker
Group=zecswap-maker
WorkingDirectory=/var/lib/zecswap-maker
StateDirectory=zecswap-maker
StateDirectoryMode=0700
EnvironmentFile=/etc/zecswap-maker/secrets.env
Environment=RAYON_NUM_THREADS=1
Environment=TOKIO_WORKER_THREADS=2
Environment=RUST_LOG=info,zcash_client_backend=warn
ExecStart=/opt/zecswap/current/zecswap-maker --config /etc/zecswap-maker/config.toml serve
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
