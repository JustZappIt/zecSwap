{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zecswap-testnet",
  "account_id": "<cloudflare account id>",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  // The maker's MAKER_TICKET_SECRET, set with `wrangler secret put TICKET_SECRET`.
  "secrets": { "required": ["TICKET_SECRET"] },
  "vpc_services": [
    { "binding": "ORIGIN", "service_id": "<workers vpc service id>" }
  ]
}
