// The mainnet gateway: the same Worker, through the droplet's tunnel to the mainnet nginx on
// 127.0.0.1:8090 (deploy/mainnet/install.sh). From deploy/worker/:
//   npx wrangler secret put TICKET_SECRET -c wrangler.mainnet.local.jsonc   (the mainnet maker's
//   MAKER_TICKET_SECRET), then npx wrangler deploy -c wrangler.mainnet.local.jsonc
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zecswap-mainnet",
  "account_id": "<cloudflare account id>",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "secrets": { "required": ["TICKET_SECRET"] },
  "vpc_services": [
    // A VPC service of its own: the droplet's tunnel, 127.0.0.1, HTTP port 8090.
    { "binding": "ORIGIN", "service_id": "<workers vpc service id>" }
  ]
}
